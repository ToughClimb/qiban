# Demo is the default and never calls the provider.
QIBAN_MODE=demo
# Local development only: DEEPSEEK_API_KEY=
# In Codex Cloud, configure DEEPSEEK_API_KEY as a network secret for api.deepseek.com.
# QIBAN_ACCESS_TOKEN= # 24+ characters; shared invite code, never the provider key
HOST=127.0.0.1
PORT=3000
